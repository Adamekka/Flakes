#!/usr/bin/env bash
set -e
if [[ ! -d "/home/lpbigfish/Projects/Flakes/templates/flutter" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/lpbigfish/Projects/Flakes/templates/flutter")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/lpbigfish/Projects/Flakes/templates/flutter" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/lpbigfish/Projects/Flakes/templates/flutter/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/lpbigfish/Projects/Flakes/templates/flutter/.envrc" "/home/lpbigfish/Projects/Flakes/templates/flutter/.direnv"/*.rc
